{
  "name": "blurry-report",
  "compatibility_date": "2026-11-01",
  "main": "src/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these paths run the Worker; every other request stays a free static-asset hit.
    "run_worker_first": ["/c", "/c/*", "/stats", "/stats/*", "/stats.json"]
  },
  // Click counts for /c/<slug> (aggregates only, no IPs). Schema: migrations/0001_clicks.sql.
  "d1_databases": [
    { "binding": "DB", "database_name": "blurry-clicks", "database_id": "5c6e9d46-f8d1-4266-9304-aac9a916b01b", "migrations_dir": "migrations" }
  ],
  // /stats password: Worker secret STATS_PASSWORD (set in Cloudflare, never in this repo).
  "routes": [
    { "pattern": "blurryreport.com", "custom_domain": true },
    { "pattern": "www.blurryreport.com", "custom_domain": true }
  ]
}
